# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./voxagent.db
# Postgres (production):
# DATABASE_URL=postgresql://voxagent:voxagent@db:5432/voxagent

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Groq LLM ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Knowledge Base ---
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Pinecone Vector Database (free tier) ---
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=voxagent-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Embedding Model (local, no API key needed) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
# Add your deployed frontend origin(s) here (e.g. the Docker frontend
# container's published port, or your production domain).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8080

# --- Application ---
APP_NAME=VoxAgent AI Backend
ENV=development
